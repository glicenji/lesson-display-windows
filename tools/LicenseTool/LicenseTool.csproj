<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>LicenseTool</RootNamespace>
    <AssemblyName>LicenseTool</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- Keep this tool for yourself only — it's what creates and can inspect
       license keys. Never publish it alongside the app or commit
       private.key to source control. -->

  <ItemGroup>
    <Compile Include="..\..\shared\Licensing\*.cs" />
  </ItemGroup>

</Project>
